# Cashtrix environment
# Copy to `.env` (gitignored) and fill in. Expo only exposes EXPO_PUBLIC_* to
# the bundle — never put the service role key here (that lives in Edge
# Functions only, PRD §4.4).

# Publishable (anon) key for project `Cashtrix` — safe in the bundle, RLS is
# the actual guard. Get it from the Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
